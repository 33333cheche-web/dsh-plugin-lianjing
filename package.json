{
  "name": "dsh-plugin-lianjing",
  "version": "2.0.2",
  "description": "莲鲸 · 陪你干活的桌宠：一只在莲台上打坐的鲸鱼娘，浮在屏幕角落，替你看住所有 agent——正在跑的会话、子任务进度、token 和耗时一眼能看到，点一下跳回对应对话；闲下来陪你敲两下木鱼，顺手翻两页佛经。网页浮层和 Windows 桌面悬浮壳两套，尺寸三档可缩。",
  "icon": "./icon.png",
  "keywords": [
    "dsh",
    "dsh-plugin",
    "deepseek-harness",
    "desktop-pet",
    "pet",
    "anime",
    "whale",
    "agent-tree",
    "session-monitor",
    "token-usage",
    "莲鲸",
    "桌宠",
    "鲸鱼娘",
    "功课面板",
    "sutra",
    "buddhism"
  ],
  "type": "module",
  "main": "./index.js",
  "license": "MIT",
  "author": "33333cheche-web",
  "engines": {
    "node": ">=22.19.0",
    "dsh": ">=0.2.1-rc.5"
  },
  "publishConfig": {
    "access": "public"
  },
  "repository": {
    "type": "git",
    "url": "git+https://github.com/33333cheche-web/dsh-plugin-lianjing.git"
  },
  "homepage": "https://33333cheche-web.github.io/dsh-plugin-lianjing/",
  "bugs": {
    "url": "https://github.com/33333cheche-web/dsh-plugin-lianjing/issues"
  },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./icon": "./icon.png"
  },
  "files": [
    "index.js",
    "client.js",
    "online.js",
    "icon.png",
    "cordis.patch.yml",
    "assets/",
    "corpus/",
    "skill/",
    "desktop/",
    "docs/",
    "scripts/",
    "README.md",
    "CHANGELOG.md",
    "NOTICE"
  ],
  "scripts": {
    "test": "node verify/smoke.mjs",
    "prepublishOnly": "node verify/smoke.mjs",
    "sound": "node scripts/make-muyu.mjs"
  },
  "dsh": {
    "manifestVersion": 1,
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-layout"
      ]
    }
  }
}
